    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1",
