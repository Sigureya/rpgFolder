{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "baseUrl": "./"
  },
  "include": ["src/**/*"], // src 配下のすべてのファイルを含む
  "exclude": ["node_modules", ".vscode"]
}
